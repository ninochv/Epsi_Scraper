# ============================================
# Variables d'environnement pour Epsi Scraper
# Copiez ce fichier en .env et ajustez les valeurs
# ============================================

# Port du serveur (defaut: 8080)
PORT=8080

# Intervalle de rafraichissement des calendriers en minutes (defaut: 60)
REFRESH_MIN=60

# Cle de chiffrement Fernet pour les mots de passe
# IMPORTANT: Generez une cle unique et gardez-la secrete!
# Commande pour generer: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Si non definie, une cle sera auto-generee et sauvegardee dans /data/.fernet_key
FERNET_KEY=

# Emplacement de la base de donnees (defaut: /data/users.db en Docker)
# EPSI_DB=/data/users.db

# Repertoire des fichiers ICS (defaut: /data/public en Docker)
# ICS_DIR=/data/public

# Repertoire des donnees persistantes (defaut: /data en Docker)
# DATA_DIR=/data
